# API .env for production. Generate the key with: php artisan key:generate
APP_NAME="Company Operations Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ops.example.com
FRONTEND_URL=https://ops.example.com
APP_TIMEZONE=UTC
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=company_ops
DB_USERNAME=ops_app          # a dedicated user with rights on this database only - never root
DB_PASSWORD=

# Same origin as the SPA, over HTTPS only
SESSION_DRIVER=database
SESSION_DOMAIN=ops.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=ops.example.com
TRUSTED_PROXIES=127.0.0.1        # the reverse proxy in front of PHP-FPM (use * only if the app is reachable solely through it)
OPS_HSTS=true
OPS_FORCE_HTTPS=true

CACHE_STORE=database             # database or redis; a file cache breaks the scheduler heartbeat check on multiple servers
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@ops.example.com
MAIL_FROM_NAME="${APP_NAME}"
SMS_DRIVER=brevo                 # brevo | africastalking | log
SMS_SENDER=OPSPLATFORM
BREVO_API_KEY=
OPS_PHONE_COUNTRY=250
OPS_ADMIN_EMAIL=
OPS_ADMIN_PHONE=
OPS_ADMIN_PASSWORD=              # used by the first seed only; remove it from .env afterwards

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http               # TLS ends at nginx

OPS_RETAIN_DELIVERY_DAYS=365
OPS_RETAIN_NOTIFICATION_DAYS=180
