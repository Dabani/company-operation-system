# company-ops-web/.env.production - read at BUILD time (npm run build). Nothing secret belongs here: it ends up in the browser.
VITE_REVERB_APP_KEY=              # same value as REVERB_APP_KEY (public key, not the secret)
VITE_REVERB_HOST=ops.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
